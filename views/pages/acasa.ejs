<%# views/pages/acasa.ejs — Pagina 1: Acasă (Hero, Trust Bar, Calculator, Produse Beton) %>

<!-- ==========================================
     PAGINA 1: ACASĂ (HERO, TRUST, CALC, PRODUSE)
     ========================================== -->
<main id="page-acasa" class="page-view active">

    <!-- Hero Section -->
    <section class="hero">
        <!-- Video fundal cinematic -->
        <video class="hero__video-bg" autoplay muted loop playsinline poster="/photos/Statie.jpg">
            <source src="/photos/statie_betoane_promo_v4_bluewave.mp4" type="video/mp4">
        </video>
        <div class="hero__overlay"></div>

        <div class="hero-box">
            <h1>Beton de înaltă precizie.<br>Livrare rapidă.</h1>
            <p>Stație ecologică automatizată. Capacitate de producție industrială, calitate controlată prin laborator propriu și flotă modernă de cife și pompe pentru șantierul tău.</p>

            <div class="hero-buttons">
                <a href="tel:0720006655" class="btn-suna" style="padding: 14px 30px; font-size: 16px;">📞 Sună la Dispecerat</a>
                <a href="#calculator" class="btn-menu" style="padding: 14px 28px; font-size: 15px;">🧮 Calculează Necesarul</a>
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <section class="trust-bar reveal">
        <div class="trust-item"><h3>ISO 9001</h3><p>Calitate Certificată</p></div>
        <div class="trust-item"><h3>ISC</h3><p>Laborator Autorizat</p></div>
        <div class="trust-item"><h3>24/7</h3><p>Dispecerat &amp; Livrare</p></div>
    </section>

    <!-- ══════════════════════════════════════
         CIFRE IMPACT — 30+ lucrări, din 2003
         ══════════════════════════════════════ -->
    <section class="impact-stats reveal">
        <div class="impact-stats__bg-text" aria-hidden="true">UBC</div>
        <div class="impact-stats__inner">
            <div class="impact-stat" data-count="30" data-suffix="+">
                <div class="impact-stat__number">
                    <span class="impact-counter" data-target="30">0</span><span class="impact-suffix">+</span>
                </div>
                <div class="impact-stat__label">Lucrări<br>la activ</div>
            </div>

            <div class="impact-stats__divider" aria-hidden="true"></div>

            <div class="impact-stat" data-count="2003" data-suffix="">
                <div class="impact-stat__number">
                    <span class="impact-counter" data-target="2003">0</span>
                </div>
                <div class="impact-stat__label">Anul<br>înființării</div>
            </div>

            <div class="impact-stats__divider" aria-hidden="true"></div>

            <div class="impact-stat" data-count="60" data-suffix="+">
                <div class="impact-stat__number">
                    <span class="impact-counter" data-target="60">0</span><span class="impact-suffix"> m³</span>
                </div>
                <div class="impact-stat__label">Pe oră<br>capacitate</div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════
         SERVICIILE NOASTRE — Prestări & Închiriere Utilaje
         ══════════════════════════════════════ -->
    <section id="servicii" class="servicii-section reveal">
        <div class="servicii-header">
            <span class="servicii-eyebrow">Soluții Complete de Construcții</span>
            <h2>Serviciile <span>Noastre</span></h2>
            <p>De la producția și livrarea betonului de înaltă calitate până la lucrări industriale complexe și închiriere de utilaje grele.</p>
        </div>

        <div class="servicii-grid">

            <!-- Card 1: Prestări Servicii -->
            <div class="servicii-card">
                <div class="servicii-card__head">
                    <div class="servicii-icon">🏗️</div>
                    <h3>Prestări Servicii</h3>
                </div>
                <ul class="servicii-list--2cols">
                    <li>Construcții civile și industriale</li>
                    <li>Proiectare și execuție drumuri, terasamente, hale, parcuri</li>
                    <li>Lucrări de excavații, demolări</li>
                    <li>Rețele de alimentare cu apă și canalizare</li>
                    <li>Amenajări spații verzi</li>
                    <li>Amenajări parcuri</li>
                </ul>
            </div>

            <!-- Card 2: Închiriere Utilaje -->
            <div class="servicii-card">
                <div class="servicii-card__head">
                    <div class="servicii-icon">🚜</div>
                    <h3>Închiriere Utilaje</h3>
                </div>
                <ul class="servicii-list--2cols">
                    <li>Autograder</li>
                    <li>Buldoexcavatoare</li>
                    <li>Încărcătoare frontale</li>
                    <li>Miniîncărcătoare frontale</li>
                    <li>Miniexcavatoare</li>
                    <li>Excavatoare șenile și pneuri</li>
                    <li>Compactoare pentru asfalt (2, 3, 4, 7, 9, 11 tone)</li>
                    <li>Compactoare pământ 12 - 16 tone</li>
                    <li>Nacelă</li>
                    <li>Repartizator asfalt</li>
                    <li>Freze asfalt (0,5 m, 1 m, 2 m)</li>
                    <li>Gudronator</li>
                    <li>Transport materiale și mărfuri</li>
                    <li>Trailer Special (2T – 40T)</li>
                </ul>
            </div>

        </div>
    </section>

    <!-- ══════════════════════════════════════
         VIDEO — Prezentare stație UBC
         ══════════════════════════════════════ -->
    <section class="video-section reveal">
        <div class="video-section__header">
            <span class="video-section__tag">▶ Prezentare</span>
            <h2>Vezi stația noastră în acțiune</h2>
            <p>Producție 100% automatizată, control de calitate în timp real și flotă proprie de livrare.</p>
        </div>
        <div class="video-wrapper">
            <!--
                Video local servit de Express din public/photos/
                Dacă vrei YouTube/Vimeo în viitor, înlocuiește <video> cu <iframe src="...">
            -->
            <video
                id="ubc-video"
                controls
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                poster="/photos/Statie.jpg"
                aria-label="Prezentare Stație Betoane UBC Oltenița">
                <source src="/photos/statie_betoane_promo_v4_bluewave.mp4" type="video/mp4">
                Browserul tău nu suportă redarea video.
            </video>
        </div>
    </section>

    <!-- Calculator Dinamic -->
    <section id="calculator" class="calc-section reveal">
        <h2 style="font-size: 2.4rem; margin-bottom: 10px; font-weight: 900;">Calculează Volumul Exact</h2>
        <p style="color: var(--text-gri); margin-bottom: 40px;">Introdu dimensiunile elementului de turnat pentru a afla necesarul de beton.</p>

        <div class="calc-box">
            <div class="calc-inputs-wrapper">
                <div class="calc-group">
                    <label>Lungime (metri)</label>
                    <input type="number" id="lungime" placeholder="ex: 12" class="calc-input" step="0.1">
                </div>
                <div class="calc-group">
                    <label>Lățime (metri)</label>
                    <input type="number" id="latime" placeholder="ex: 6" class="calc-input" step="0.1">
                </div>
                <div class="calc-group">
                    <label>Grosime (metri)</label>
                    <input type="number" id="grosime" placeholder="ex: 0.15" class="calc-input" step="0.01">
                </div>
            </div>

            <!-- Rezultat vizual: coloană beton animată + date numerice -->
            <div class="calc-result-box">
                <!-- Pilonul de beton animat -->
                <div class="calc-pillar-wrap">
                    <div class="calc-pillar">
                        <div class="calc-pillar__fill" id="calc-pillar-fill">
                            <div class="calc-pillar__wave"></div>
                        </div>
                    </div>
                </div>

                <!-- Rezultate numerice -->
                <div class="calc-result-text">
                    <span class="calc-result-label">Volum Total Necesar:</span>
                    <h3 id="rezultat-volum">0.00 <span style="font-size: 1.8rem; font-weight: 700;">m³</span></h3>
                    <div class="calc-breakdown" id="calc-breakdown">
                        <small id="calc-trucks-text">Introdu dimensiunile mai sus</small>
                    </div>
                </div>
            </div>

            <a href="tel:0720006655" id="btn-comanda-calc" class="btn-suna" style="width: 100%; justify-content: center; padding: 16px; opacity: 0.5; pointer-events: none;">Introdu dimensiunile pentru comandă</a>

        </div>
    </section>

    <!-- Clase și Specificații Beton -->
    <section id="produse" class="produse reveal">
        <h2 style="font-size: 2.6rem; margin-bottom: 15px; font-weight: 900;">Clase și Specificații Beton</h2>
        <p style="color: var(--text-gri); font-size: 1.1rem; max-width: 650px; margin: 0 auto 40px auto;">Selectează categoria de turnare pentru a vizualiza rețetele noastre omologate conform standardelor europene.</p>

        <div class="tabs-container">
            <button class="tab-btn active" data-tab="usoare">🧱 Betoane Ușoare &amp; Uzuale (B150 - B350)</button>
            <button class="tab-btn" data-tab="grele">🏗️ Betoane Grele &amp; Structurale (B400 - B450)</button>
        </div>

        <!-- Grid Betoane Ușoare -->
        <div id="grid-usoare" class="grid-produse">
            <div class="card">
                <div><h3>B150</h3><span class="standard">C12/15</span><p>Ideal pentru egalizări de fundație, umpluturi, blocuri simple de betonare și trotuare pietonale fără solicitări masive.</p></div>
                <div class="card-footer-info">💡 Agregat optimizat • Turnare facilă</div>
            </div>
            <div class="card">
                <div><h3>B200</h3><span class="standard">C16/20 (Nestructural)</span><p>Recomandat pentru fundații de corpuri ușoare, stâlpișori de delimitare, ziduri de sprijin mici și platforme auto pietonale.</p></div>
                <div class="card-footer-info">💡 Rezistență moderată • Uz general</div>
            </div>
            <div class="card">
                <span class="card-badge">🔥 Cel mai vândut</span>
                <div><h3>B250</h3><span class="standard">C18/22.5 (sau C16/20 Struct.)</span><p>Standardul de aur pentru rezidențial: fundații armate de case, pardoseli, stâlpi principali, centuri și grinzi standard.</p></div>
                <div class="card-footer-info">💡 Elasticitate &amp; Durabilitate sporită</div>
            </div>
            <div class="card">
                <div><h3>B300</h3><span class="standard">C20/25</span><p>Dedicat elementelor structurale solicitate: planșee armate peste etaj, stâlpi de rezistență, grinzi portante și diafragme.</p></div>
                <div class="card-footer-info">💡 Conținut ridicat de ciment pur</div>
            </div>
            <div class="card">
                <div><h3>B350</h3><span class="standard">C25/30</span><p>Beton structural de înaltă performanță pentru radiere generale, planșee cu deschideri mari și infrastructuri comerciale grele.</p></div>
                <div class="card-footer-info">💡 Protecție anti-fisurare maximă</div>
            </div>
        </div>

        <!-- Grid Betoane Grele -->
        <div id="grid-grele" class="grid-produse hidden">
            <div class="card">
                <span class="card-badge heavy">🏗️ Industrial Greu</span>
                <div><h3>B400</h3><span class="standard">C30/37</span><p>Conceput pentru infrastructură critică, hale industriale portante, fundații pentru utilaje de tonaj greu, piloni și poduri.</p></div>
                <div class="card-footer-info" style="color: #FF4C4C;">⚡ Rezistență mecanică superioară</div>
            </div>
            <div class="card">
                <span class="card-badge heavy">🛡️ Structuri Speciale</span>
                <div><h3>B450</h3><span class="standard">C35/45</span><p>Formula supremă pentru medii chimic agresive, piloni forați de mare adâncime, lucrări hidrotehnice și solicitări seismice extreme.</p></div>
                <div class="card-footer-info" style="color: #FF4C4C;">⚡ Impermeabilitate &amp; Densitate maximă</div>
            </div>
        </div>
    </section>

</main>
