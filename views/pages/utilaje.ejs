<%# views/pages/utilaje.ejs — Flotă și Utilaje UBC (Design simplificat) %>

<main id="page-utilaje" class="page-view">

    <%# ── HEADER PAGINĂ ── %>
    <div class="ut-header">
        <div class="ut-header__inner">
            <span class="ut-eyebrow">Dotare Tehnică Industrială</span>
            <h1>Flotă și <span>Utilaje UBC</span></h1>
            <p>Echipamente de mare capacitate și tehnologie automatizată pregătite pentru orice provocare pe șantier — de la producție și transport beton până la închiriere de utilaje grele.</p>
        </div>
    </div>

    <%# ── HERO FEATURED SHOWCASE (Poza de ansamblu Statie3.jpg) ── %>
    <section class="ut-hero-showcase">
        <div class="ut-showcase-card">
            <div class="ut-showcase-card__image-wrap">
                <img src="/photos/Statie3.jpg" alt="Ansamblu Stație de betoane UBC Oltenița" class="ut-showcase-card__img">
                <div class="ut-showcase-card__badge">
                    <span>⚡ CAPACITATE MAXIMĂ</span>
                    <strong>60 m³ / Oră</strong>
                </div>
            </div>
            <div class="ut-showcase-card__content">
                <span class="ut-cat-badge ut-cat--productie">Inima Stației UBC</span>
                <h2>Stația Centrală de Betoane <span>UBC</span></h2>
                <p>Proces industrial 100% automatizat cu sistem electronic de cântărire și dozare a agregatelor, cimentului, apei și aditivilor. Elimină complet erorile umane și garantează că fiecare șarjă de beton livrată în Oltenița și împrejurimi respectă cu strictețe rețeta omologată.</p>
            </div>
        </div>
    </section>

    <%# ── LISTA UTILAJE ȘI ECHIPAMENTE ── %>
    <section class="ut-simple-list-section">
        <div class="ut-list-title">
            <h2>Echipamente și <span>Utilaje Disponibile</span></h2>
            <p>Lista completă de utilaje disponibile pentru lucrări de construcții și închiriere</p>
        </div>

        <div class="ut-simple-grid">

            <!-- Card 1: Închiriere Utilaje -->
            <div class="ut-simple-card">
                <div class="ut-simple-card__head">
                    <div class="ut-simple-icon">🚜</div>
                    <div>
                        <h3>Închiriere Utilaje Grele</h3>
                        <small>Echipamente pregătite pentru șantier</small>
                    </div>
                </div>
                <ul class="ut-simple-ul">
                    <li><span>•</span> Buldoexcavatoare</li>
                    <li><span>•</span> Automacara 12.5 Tone</li>
                    <li><span>•</span> Încărcătoare frontale</li>
                    <li><span>•</span> Miniîncărcătoare frontale</li>
                    <li><span>•</span> Vibrocompactoare</li>
                    <li><span>•</span> Nacelă</li>
                    <li><span>•</span> Repartizator asfalt</li>
                    <li><span>•</span> Autospecială Vidanja cu autocurățător</li>
                    <li><span>•</span> Transport materiale și mărfuri</li>
                    <li><span>•</span> Trailer Special de la 2 Tone la 28 Tone</li>
                </ul>
            </div>

            <!-- Card 2: Producție & Transport Beton -->
            <div class="ut-simple-card">
                <div class="ut-simple-card__head">
                    <div class="ut-simple-icon">🏗️</div>
                    <div>
                        <h3>Producție &amp; Pompare Beton</h3>
                        <small>Flota proprie de livrare UBC</small>
                    </div>
                </div>
                <ul class="ut-simple-ul">
                    <li><span>•</span> Stație centrală de betoane automatizată (60 m³/h)</li>
                    <li><span>•</span> Flotă autobetoniere (cife) de 8 m³ cu agitare continuă</li>
                    <li><span>•</span> Pompă auto-elevatoare (autopompă) cu braț articulat de 28m</li>
                    <li><span>•</span> Pompă staționară de înaltă presiune (distanțe mari/verticală)</li>
                    <li><span>•</span> Laborator mobil autorizat ISC pentru probe &amp; rezistență</li>
                </ul>
            </div>

        </div>
    </section>

</main>
