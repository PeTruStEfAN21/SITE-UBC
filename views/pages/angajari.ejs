<%# views/pages/angajari.ejs — Pagina Cariere & Angajări UBC %>

<main id="page-angajari" class="page-view">

    <%# ── HEADER PAGINĂ ── %>
    <div class="cp-header">
        <div class="cp-header__inner">
            <span class="cp-eyebrow">🚀 Alătură-te Echipei Union Business Company</span>
            <h1>Cariere &amp; <span>Angajări UBC</span></h1>
            <p>Echipa noastrã se mărește! Căutăm colegi serioși și dedicați pentru proiectele noastre din Oltenița și județul Călărași.</p>
        </div>
    </div>

    <%# ── SECȚIUNEA POSTURI DISPONIBILE ── %>
    <section class="angajari-section">
        <div class="angajari-container">

            <div class="angajari-intro">
                <span class="zone-eyebrow">💼 Oportunități de Carieră</span>
                <h2>Posturi <span>Disponibile</span></h2>
                <p>Alege postul potrivit pentru tine și aplică direct cu CV-ul tău.</p>
            </div>

            <div class="job-cards-grid">

                <!-- Job 1: Inginer Constructor -->
                <div class="job-card">
                    <div class="job-card__badge">Full-Time</div>
                    <div class="job-card__icon">👷‍♂️</div>
                    <div class="job-card__content">
                        <span class="job-card__num">01</span>
                        <h3>Inginer Constructor</h3>
                        <p class="job-card__sub">Construcții civile, industriale și drumuri</p>
                    </div>
                    <div class="job-card__footer">
                        <a href="mailto:ubcbeton@gmail.com?subject=Aplicare%20Post%20Inginer%20Constructor" class="btn-suna job-card__btn">✉️ Aplică pentru acest post</a>
                    </div>
                </div>

                <!-- Job 2: Șef Șantier -->
                <div class="job-card">
                    <div class="job-card__badge">Full-Time</div>
                    <div class="job-card__icon">🏗️</div>
                    <div class="job-card__content">
                        <span class="job-card__num">02</span>
                        <h3>Șef Șantier</h3>
                        <p class="job-card__sub">Organizare și coordonare echipe pe șantier</p>
                    </div>
                    <div class="job-card__footer">
                        <a href="mailto:ubcbeton@gmail.com?subject=Aplicare%20Post%20Sef%20Santier" class="btn-suna job-card__btn">✉️ Aplică pentru acest post</a>
                    </div>
                </div>

                <!-- Job 3: Mecanic Utilaj Buldoexcavator -->
                <div class="job-card">
                    <div class="job-card__badge">Full-Time</div>
                    <div class="job-card__icon">🚜</div>
                    <div class="job-card__content">
                        <span class="job-card__num">03</span>
                        <h3>Mecanic Utilaj Buldoexcavator</h3>
                        <p class="job-card__sub">Reparare și întreținere excavator / utilaje</p>
                    </div>
                    <div class="job-card__footer">
                        <a href="mailto:ubcbeton@gmail.com?subject=Aplicare%20Post%20Mecanic%20Buldoexcavator" class="btn-suna job-card__btn">✉️ Aplică pentru acest post</a>
                    </div>
                </div>

            </div>

            <%# ── SECȚIUNEA CUM APLICI (EMAIL CV + TELEFON DETALII) ── %>
            <div class="apply-box-card">
                <div class="apply-box__header">
                    <h2>📋 Cum poți aplica?</h2>
                    <p>Trimite-ne CV-ul tău pe email sau sună-ne direct pentru detalii.</p>
                </div>

                <div class="apply-methods-grid">

                    <!-- Metoda 1: Trimite CV pe Email -->
                    <div class="apply-method-card">
                        <div class="apply-method__icon">✉️</div>
                        <h3>Trimite CV-ul pe Email</h3>
                        <p>Trimite CV-ul tău pe adresa oficială a companiei:</p>
                        <a href="mailto:ubcbeton@gmail.com" class="apply-email-link">ubcbeton@gmail.com</a>
                        <a href="mailto:ubcbeton@gmail.com" class="btn-suna apply-btn-action">✉️ Trimite CV pe Email</a>
                    </div>

                    <!-- Metoda 2: Sună pentru Detalii -->
                    <div class="apply-method-card">
                        <div class="apply-method__icon">📞</div>
                        <h3>Informații la Telefon</h3>
                        <p>Pentru mai multe detalii și informații, sună la dispecerat:</p>
                        <a href="tel:0720006655" class="apply-phone-link">0720 006 655</a>
                        <div class="apply-phone-alt">Alternativ: <a href="tel:0724349503" style="color: var(--verde-ubc); font-weight: 700;">0724 349 503</a></div>
                        <a href="tel:0720006655" class="btn-suna apply-btn-action">📞 Sună pentru Detalii</a>
                    </div>

                </div>
            </div>

        </div>
    </section>

</main>
