<!-- ══════════════════════════════════════════════
     JS SCROLL INTERACTIV — Reveal + Contoare
     ══════════════════════════════════════════════ -->
<script>
(function () {
    if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('#page-despre .dp-reveal').forEach(el => el.classList.add('dp-reveal--visible'));
        document.querySelectorAll('#page-despre .dp-counter').forEach(el => { el.textContent = el.dataset.target; });
        return;
    }

    // ── Reveal observer ────────────────────────────────
    const revealObs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('dp-reveal--visible');
                revealObs.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('#page-despre .dp-reveal').forEach(el => revealObs.observe(el));

    // ── Counter observer ───────────────────────────────
    function animateDpCounter(el, target) {
        const dur = target > 1000 ? 1400 : 1800;
        const start = performance.now();
        const easeOut = t => 1 - Math.pow(1 - t, 3);
        const tick = now => {
            const elapsed = Math.min(now - start, dur);
            const pct = easeOut(elapsed / dur);
            el.textContent = Math.round(pct * target).toLocaleString('ro-RO');
            if (elapsed < dur) requestAnimationFrame(tick);
            else el.textContent = target.toLocaleString('ro-RO');
        };
        requestAnimationFrame(tick);
    }

    const counterObs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const target = parseInt(entry.target.dataset.target, 10);
                animateDpCounter(entry.target, target);
                counterObs.unobserve(entry.target);
            }
        });
    }, { threshold: 0.4 });

    document.querySelectorAll('#page-despre .dp-counter').forEach(el => counterObs.observe(el));

    // ── Active section highlight ───────────────────────
    const sectionObs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('dp-section--active');
            } else {
                entry.target.classList.remove('dp-section--active');
            }
        });
    }, { threshold: 0.25 });

    document.querySelectorAll('#page-despre .dp-section').forEach(el => sectionObs.observe(el));
})();
</script>
