<%# views/index.ejs — Layout principal: asamblează toate partials-urile și paginile %>
<!DOCTYPE html>
<html lang="ro">

    <%- include('partials/head') %>

<body>

    <!-- 0. Intro Animation — primul absolut, apare instant la load -->
